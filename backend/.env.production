# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID="294998189349-qkqo2pholvm8fdg6qnbl15n8q56edcua.apps.googleusercontent.com"

# ─── Firebase ─────────────────────────────────────────────────────────────────
